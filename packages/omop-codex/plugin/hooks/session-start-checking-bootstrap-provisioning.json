{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "cmd /c \"node \\\"${PLUGIN_ROOT}/components/bootstrap/dist/cli.js\\\" hook session-start || exit 0\"",
						"commandWindows": "powershell -NoProfile -ExecutionPolicy Bypass -File \"${PLUGIN_ROOT}\\components\\bootstrap\\scripts\\bootstrap.ps.\"",
						"timeout": 30,
						"statusMessage": "(OmOP) Checking Bootstrap Provisioning"
					}
				]
			}
		]
	}
}
