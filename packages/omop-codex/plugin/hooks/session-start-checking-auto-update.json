{
	"hooks": {
		"SessionStart": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "cmd /c \"node \\\"${PLUGIN_ROOT}/scripts/auto-update.mjs\\\" hook session-start || exit 0\"",
						"timeout": 5,
						"statusMessage": "(OmOP) Checking Auto Update"
					}
				],
				"matcher": "^startup$"
			}
		]
	}
}
