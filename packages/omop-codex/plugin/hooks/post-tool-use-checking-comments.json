{
	"hooks": {
		"PostToolUse": [
			{
				"hooks": [
					{
						"type": "command",
						"command": "cmd /c \"node \\\"${PLUGIN_ROOT}/components/comment-checker/dist/cli.js\\\" hook post-tool-use || exit 0\"",
						"timeout": 30,
						"statusMessage": "(OmOP) Checking Comments"
					}
				],
				"matcher": "^(apply_patch|write|Write|edit|Edit|multi_edit|multiedit|MultiEdit)$"
			}
		]
	}
}
