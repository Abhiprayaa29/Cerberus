{
  "name": "oh-my-open-pentest-web",
  "version": "0...0",
  "private": true,
  "scripts": {
    "prepare": "node ./scripts/generate-docs-content.mjs",
    "prebuild": "node ./scripts/prepare-build.mjs",
    "dev": "next dev",
    "build": "bun --bun next build --no-lint",
    "start": "next start",
    "lint": "biome lint app components lib e2e scripts && eslint --cache --cache-location .next/cache/eslint/.eslintcache \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx,mjs}\" \"e2e/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "lint:fix": "biome lint --write app components lib e2e scripts && eslint --cache --cache-location .next/cache/eslint/.eslintcache --fix \"app/**/*.{ts,tsx}\" \"components/**/*.{ts,tsx}\" \"lib/**/*.{ts,tsx,mjs}\" \"e2e/**/*.{ts,tsx}\" \"scripts/**/*.mjs\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,jsx,mjs,json,css,md}\"",
    "type-check": "node ./scripts/generate-docs-content.mjs && tsgo --noEmit",
    "test:e2e": "bun --bun playwright test",
    "test:e2e:ui": "bun --bun playwright test --ui",
    "test:e2e:headed": "bun --bun playwright test --headed",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts"
  },
  "dependencies": {
    "@radix-ui/react-separator": "^....8",
    "@radix-ui/react-slot": "^..2..",
    "class-variance-authority": "^0.7..",
    "clsx": "^2....",
    "geist": "^..7.0",
    "lucide-react": "...6.0",
    "marked": "^.8.0..",
    "next": ".5.5..8",
    "next-intl": "^...2.0",
    "react": "^.9.2.6",
    "react-dom": "^.9.2.6",
    "tailwind-merge": "^3.6.0",
    "tailwindcss-animate": "^..0.7"
  },
  "browserslist": [
    "chrome >= .00",
    "firefox >= .00",
    "safari >= .5",
    "edge >= .00"
  ],
  "overrides": {
    "brace-expansion": "5.0.6",
    "fast-xml-parser": "5.7.3",
    "flatted": "3...2",
    "minimatch": ".0.2..",
    "path-to-regexp": "8...2",
    "picomatch": "..0..",
    "postcss": "8.5..5",
    "qs": "6..5..",
    "yaml": "2.9.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2....5",
    "@opennextjs/cloudflare": "^...9...",
    "@playwright/test": "..60.0",
    "@tailwindcss/postcss": "..3.0",
    "@types/node": "^25.9..",
    "@types/react": "^.9.2..5",
    "@types/react-dom": "^.9.2.3",
    "@typescript/native-preview": "7.0.0-dev.202605.8..",
    "eslint": "^9.39..",
    "eslint-config-next": ".5.5..8",
    "eslint-config-prettier": ".0...8",
    "eslint-plugin-prettier": "5.5.5",
    "globals": "^.7.6.0",
    "postcss": "^8.5..5",
    "prettier": "3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "tailwindcss": "..3.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.59..",
    "wrangler": "^..93.0"
  }
}
